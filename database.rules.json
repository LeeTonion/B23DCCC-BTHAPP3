{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "avatarUrl": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$session": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "activeChat": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString()"
      }
    },
    "conversations": {
      "$convId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && (newData.child('members').child(auth.uid).val() === true || data.child('members').child(auth.uid).val() === true)",
        "type": {
          ".validate": "newData.val() === 'direct' || newData.val() === 'group'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "members": {
          "$uid": {
            ".validate": "newData.val() === true && root.child('users').child($uid).exists()"
          }
        },
        "createdBy": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "messages": {
      "$convId": {
        ".read": "auth != null && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
        "$msgId": {
          ".write": "auth != null && (root.child('conversations').child($convId).child('members').child(auth.uid).val() === true || newData.parent().parent().parent().child('conversations').child($convId).child('members').child(auth.uid).val() === true) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['senderId', 'type', 'createdAt']) && (!data.exists() ? newData.child('senderId').val() === auth.uid : newData.child('senderId').val() === data.child('senderId').val())",
          "recalled": {
            ".write": "auth != null && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.val() === true"
          },
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
              ".validate": "newData.isString() && newData.val().length <= 8"
            }
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$convId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('conversations').child($convId).child('members').child(auth.uid).val() === true || newData.parent().parent().parent().child('conversations').child($convId).child('members').child(auth.uid).val() === true)"
        }
      }
    },
    "readStatus": {
      "$convId": {
        ".read": "auth != null && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "typing": {
      "$convId": {
        ".read": "auth != null && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('conversations').child($convId).child('members').child(auth.uid).val() === true",
          ".validate": "newData.val() === true"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notifId": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('fromUid').val() === auth.uid))"
        }
      }
    }
  }
}
